; DEADWAVE HEROES · RF Worlds
config_version=5

[application]
config/name="DEADWAVE HEROES"
config/version="0.2.3"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(0.025, 0.045, 0.075, 1)

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.025, 0.045, 0.075, 1)

[input_devices]
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60
2d/default_gravity=850.0

[audio]
driver/enable_input=false
